# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Server Configuration
PORT=3000
NODE_ENV=development

# Target Project Root for Analysis (e.g. C:\xampp\htdocs\dev_tnu)
PROJECT_ROOT=C:\xampp\htdocs\dev_tnu

# MySQL Database Connection (Moodle INFORMATION_SCHEMA)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dev_tnu

# Path Directories
OUTPUT_DIR=./output
TEMPLATES_DIR=./templates
SKILLS_DIR=./skills

# Kroki Diagram Rendering API
KROKI_URL=https://kroki.io/mermaid/png
